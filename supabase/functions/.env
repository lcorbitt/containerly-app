# `supabase start` runs Edge Functions in Docker — use host.docker.internal to reach the mock on your Mac.
# If you use `supabase functions serve` on the host only (no Docker), use http://127.0.0.1:9999/api/v1 instead.
EXTERNAL_TRACKING_API_URL=http://host.docker.internal:9999/api/v1
EXTERNAL_TRACKING_API_KEY=dev
