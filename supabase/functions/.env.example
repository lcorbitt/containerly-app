# =============================================================================
# Edge Functions only — copy to `supabase/functions/.env`, then:
#   supabase stop && supabase start
#
# Mock URL (npm run mock:jsoncargo from frontend/ → port 9999):
#   • supabase start (Docker): use host.docker.internal so the container reaches your Mac.
#   • supabase functions serve on host only: use http://127.0.0.1:9999/api/v1
# Omit EXTERNAL_TRACKING_API_URL to use the built-in deterministic mock (no HTTP).
#
# Invite emails / absolute URLs in create-customer-invite (local dev):
#   PUBLIC_SITE_URL=http://localhost:3000
#
# Auth emails (invites, etc.) when running `supabase start`: captured in Mailpit, not sent externally.
#   http://127.0.0.1:54324
# =============================================================================

EXTERNAL_TRACKING_API_URL=http://host.docker.internal:9999/api/v1
EXTERNAL_TRACKING_API_KEY=dev
