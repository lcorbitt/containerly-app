# =============================================================================
# Edge Functions only — copy to `supabase/functions/.env`, then:
#   supabase stop && supabase start
#
# Mock URL (npm run mock:jsoncargo from frontend/ → port 9999):
#   • supabase start (Docker): use host.docker.internal so the container reaches your Mac.
#   • supabase functions serve on host only: use http://127.0.0.1:9999/api/v1
# Omit EXTERNAL_TRACKING_API_URL to use the built-in deterministic mock (no HTTP).
#
# Invite emails / absolute URLs in create-customer-invite (local dev):
#   PUBLIC_SITE_URL=http://localhost:3000
#
# Local email (Mailpit — bundled with `supabase start`):
#   UI:  http://127.0.0.1:54324  (Auth + transactional when RESEND_API_KEY is unset)
#   SMTP: DEV_SMTP_HOST / DEV_SMTP_PORT below
#   Do NOT set RESEND_API_KEY locally — transactional emails route to Mailpit instead.
#
# Auth emails (invites, password reset, etc.) always appear in Mailpit when using `supabase start`.
# Transactional Containerly emails (customer invites, document events, messages) use the SMTP vars below.
#
# Docker Edge runtime (`supabase start` — Mailpit SMTP on the Supabase Docker network):
DEV_SMTP_HOST=inbucket
DEV_SMTP_PORT=1025
#
# Host-only Edge (`supabase functions serve` on your machine): only works if your CLI exposes
# Mailpit SMTP on the host (some versions map 54325 → 1025). Otherwise keep using `supabase start`.
# DEV_SMTP_HOST=127.0.0.1
# DEV_SMTP_PORT=54325
#
# PUBLIC_SITE_URL=http://localhost:3000
# =============================================================================

EXTERNAL_TRACKING_API_URL=http://host.docker.internal:9999/api/v1
EXTERNAL_TRACKING_API_KEY=dev
DEV_SMTP_HOST=inbucket
DEV_SMTP_PORT=1025
PUBLIC_SITE_URL=http://localhost:3000
